# Copy to `.env` for docker compose. Every host-specific value lives here so the
# same image runs on the test box and the company server unchanged.

# Port published on the host (mapped to the container's 8080).
HOST_PORT=8080

# --- server config (read inside the container) ---
PORT=8080
STATIC_DIR=/app/static
DATA_DIR=/app/data

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,tower_http=info

# --- auth (P4) ---
# On first boot (when this admin doesn't exist yet) the server creates it, then
# you log in and add other users in the UI. Change the password after first
# login. Leave these unset once the admin exists.
ADMIN_EMAIL=admin@sa2025.local
ADMIN_PASSWORD=change-me-on-first-boot
# Set to true in production (HTTPS via the proxy) so session cookies are marked
# Secure. Leave false for plain-HTTP local testing.
COOKIE_SECURE=false

# --- NZBN lookup (MBIE Companies Register) ---
# Subscription key for the "Check Companies Register" action in TP Companies.
# Get one from https://portal.api.business.govt.nz/ (NZBN API product). The key
# is read from the server env only - there is no Settings UI entry for it.
NZBN_API_KEY=
# sandbox (default) or production.
NZBN_ENV=sandbox

# --- reserved for later phases (leave unset until then) ---
# Public base URL, used behind the proxy for the Microsoft SSO redirect (P6):
# PUBLIC_BASE_URL=https://sa2025.example.com
